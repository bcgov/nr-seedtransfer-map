#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -euo pipefail

# Print help message
show_help() {
    echo "========================================================="
    echo "  🌲 CBST Seedlot Selection Tool Control Script"
    echo "========================================================="
    echo "Usage: ./run [command]"
    echo ""
    echo "Commands:"
    echo "  dev       Start a local development server (Node/http-server)"
    echo "  lint      Verify syntax and formatting of all source files"
    echo "  format    Enforce consistent formatting with Prettier"
    echo "  help      Show this help message"
    echo "========================================================="
}

# Run the local server
run_dev() {
    echo "🚀 Launching local testing server..."
    if command -v npx &>/dev/null; then
        echo "🌐 Serving at http://localhost:8000 (using Node/http-server)"
        npx http-server docs -p 8000
    else
        echo "❌ Error: Node/npm (npx) is not installed!" >&2
        exit 1
    fi
}

# Lint JavaScript files for logical errors and Prettier formatting consistency
run_lint() {
    if [ ! -d "node_modules" ]; then
        echo "📦 'node_modules' not found! Installing dev dependencies transparently..."
        npm ci
    fi

    echo "🔍 Verifying JavaScript codebase with ESLint..."
    if ! npm run lint; then
        echo "❌ ESLint verification failed! Fix the logical/syntax issues above."
        exit 1
    fi
    echo "✅ All JavaScript files are structurally and logically sound!"

    echo "🔍 Checking Prettier formatting consistency..."
    if ! npm run format:check; then
        echo "❌ Formatting check failed! Run './run format' to format code."
        exit 1
    fi
    echo "✅ Codebase formatting is perfectly consistent!"
}

# Enforce consistent formatting using Prettier
run_format() {
    if [ ! -d "node_modules" ]; then
        echo "📦 'node_modules' not found! Installing dev dependencies transparently..."
        npm ci
    fi
    echo "🧹 Formatting HTML, CSS, and JS source files with Prettier..."
    npm run format
}

# Parse command line arguments
if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

case "$1" in
    dev)
        run_dev
        ;;
    lint)
        run_lint
        ;;
    format)
        run_format
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "❌ Unknown command: $1" >&2
        show_help
        exit 1
        ;;
esac
