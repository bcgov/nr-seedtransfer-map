{
  "name": "nr-seedtransfer-map",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "http-server docs -p 8000",
    "format": "prettier --write \"docs/**/*.{js,css,html}\" README.md",
    "format:check": "prettier --check \"docs/**/*.{js,css,html}\" README.md",
    "lint": "eslint docs/scripts",
    "lint:fix": "eslint docs/scripts --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit.test.js",
    "test:e2e": "playwright test",
    "validate": "npm run lint && npm run format:check && npm run test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "http-server": "^14.1.1",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
